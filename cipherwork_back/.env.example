# Copy to .env (never commit .env). On Railway set these as service variables.
NODE_ENV=production
PORT=8787
CORS_ORIGINS=https://<your-frontend>.up.railway.app
DATABASE_URL=                      # Railway Postgres: reference ${{Postgres.DATABASE_URL}}; empty = in-memory

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
ESCROW_CONTRACT_ID=<your-contract>.testnet
CONTRACT_OWNER_PRIVATE_KEY=ed25519:...   # deploy script only; remove from the running service after deploy
RELAYER_ACCOUNT_ID=<relayer>.testnet
RELAYER_PRIVATE_KEY=ed25519:...
TREASURY_ACCOUNT_ID=<treasury>.testnet
FEE_BPS=500
VERIFIER_KEY_ID=cw-verifier-1
VERIFIER_SEED_HEX=<64 hex chars, ed25519 seed>   # npm run keys:generate
VERIFIER_PUBLIC_KEY_HEX=<64 hex chars>
PROVIDER_ACCOUNT_ID=<provider>.testnet
DRIP_ENABLED=false                 # true only for testnet demos (gives fresh burner wallets 1 NEAR)

# Scripts only (smoke:live, CLI). The API server never reads these and never sees prompts.
DEMO_BUYER_ACCOUNT_ID=<buyer>.testnet
DEMO_BUYER_PRIVATE_KEY=ed25519:...
PROVIDER_PRIVATE_KEY=ed25519:...
NEARAI_API_KEY=                    # https://cloud.near.ai -> API Keys
